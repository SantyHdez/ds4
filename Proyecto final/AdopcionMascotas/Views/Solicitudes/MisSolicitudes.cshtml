@model IEnumerable<AdopcionMascotas.Models.Solicitud>

@{
    ViewBag.Title = "Mis Solicitudes de Adopción";
}

<div class="row">
    <div class="col-md-12">
        <h2>
            <i class="glyphicon glyphicon-list-alt"></i> Mis Solicitudes de Adopción
        </h2>
        <hr />

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                <i class="glyphicon glyphicon-ok"></i> @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                <i class="glyphicon glyphicon-exclamation-sign"></i> @TempData["Error"]
            </div>
        }

        <div class="well">
            <p><strong>Usuario:</strong> @ViewBag.NombreUsuario</p>
            <p><strong>Email:</strong> @ViewBag.Email</p>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">
                        Total de solicitudes: <strong>@Model.Count()</strong>
                    </h4>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Mascota</th>
                                    <th>Especie</th>
                                    <th>Estado</th>
                                    <th>Respuesta</th>            
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var solicitud in Model)
                                {
                                    <tr>
                                        <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <strong>@solicitud.Mascota.Nombre</strong>
                                            @if (!string.IsNullOrEmpty(solicitud.Mascota.Raza))
                                            {
                                                <br /><small class="text-muted">@solicitud.Mascota.Raza</small>
                                            }
                                        </td>
                                        <td>@solicitud.Mascota.Especie</td>
                                        <td>
                                            @if (solicitud.Estado == "Pendiente")
                                            {
                                                <span class="label label-warning">
                                                    <i class="glyphicon glyphicon-time"></i> Pendiente
                                                </span>
                                            }
                                            else if (solicitud.Estado == "Aprobada")
                                            {
                                                <span class="label label-success">
                                                    <i class="glyphicon glyphicon-ok"></i> Aprobada
                                                </span>
                                            }
                                            else if (solicitud.Estado == "Rechazada")
                                            {
                                                <span class="label label-danger">
                                                    <i class="glyphicon glyphicon-remove"></i> Rechazada
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (solicitud.FechaRespuesta.HasValue)
                                            {
                                                @solicitud.FechaRespuesta.Value.ToString("dd/MM/yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin respuesta</span>
                                            }
                                        </td>
                                      
                                    </tr>

                                    if (solicitud.Estado == "Rechazada" && !string.IsNullOrEmpty(solicitud.MotivoRechazo))
                                    {
                                        <tr>
                                            <td colspan="6" style="background-color: #f9f9f9;">
                                                <div class="alert alert-warning" style="margin-bottom: 0;">
                                                    <strong>Motivo del rechazo:</strong> @solicitud.MotivoRechazo
                                                </div>
                                            </td>
                                        </tr>
                                    }

                                    if (solicitud.Estado == "Aprobada")
                                    {
                                        <tr>
                                            <td colspan="6" style="background-color: #f0fff0;">
                                                <div class="alert alert-success" style="margin-bottom: 0;">
                                                    <strong><i class="glyphicon glyphicon-heart"></i> ¡Felicidades!</strong>
                                                    Tu solicitud fue aprobada. Pronto nos pondremos en contacto contigo para coordinar la entrega.
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Resumen por estado -->
            <div class="row" style="margin-top: 20px;">
                <div class="col-md-4">
                    <div class="panel panel-warning">
                        <div class="panel-heading text-center">
                            <h3>@Model.Count(s => s.Estado == "Pendiente")</h3>
                        </div>
                        <div class="panel-body text-center">
                            <strong>Pendientes</strong>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="panel panel-success">
                        <div class="panel-heading text-center">
                            <h3>@Model.Count(s => s.Estado == "Aprobada")</h3>
                        </div>
                        <div class="panel-body text-center">
                            <strong>Aprobadas</strong>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="panel panel-danger">
                        <div class="panel-heading text-center">
                            <h3>@Model.Count(s => s.Estado == "Rechazada")</h3>
                        </div>
                        <div class="panel-body text-center">
                            <strong>Rechazadas</strong>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <h4><i class="glyphicon glyphicon-info-sign"></i> No tienes solicitudes registradas</h4>
                <p>Explora nuestro catálogo y solicita adoptar a tu mascota favorita.</p>
                <a href="@Url.Action("Index", "Mascotas")" class="btn btn-primary">
                    <i class="glyphicon glyphicon-search"></i> Ver Mascotas Disponibles
                </a>
            </div>
        }

        <div class="text-center" style="margin-top: 30px;">
            <a href="@Url.Action("Index", "Home")" class="btn btn-default">
                <i class="glyphicon glyphicon-home"></i> Volver al Inicio
            </a>
            <a href="@Url.Action("Index", "Mascotas")" class="btn btn-primary">
                <i class="glyphicon glyphicon-th-list"></i> Ver Más Mascotas
            </a>
        </div>
    </div>
</div>