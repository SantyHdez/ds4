@{
    ViewBag.Title = "Mis Solicitudes";
}

<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="panel panel-info">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="glyphicon glyphicon-search"></i> Buscar Mis Solicitudes
                </h3>
            </div>
            <div class="panel-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="glyphicon glyphicon-exclamation-sign"></i>
                        @TempData["Error"]
                    </div>
                }

                <p class="text-muted">
                    Ingresa el correo electrónico que usaste para solicitar la adopción:
                </p>

                <form action="@Url.Action("MisSolicitudes", "Solicitudes")" method="get" class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-3 control-label">Email:</label>
                        <div class="col-md-9">
                            <input type="email" name="email" class="form-control" required placeholder="tu@email.com" />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-3 col-md-9">
                            <button type="submit" class="btn btn-primary btn-block">
                                <i class="glyphicon glyphicon-search"></i> Buscar Solicitudes
                            </button>
                        </div>
                    </div>
                </form>

                <hr />

                <div class="alert alert-info">
                    <small>
                        <i class="glyphicon glyphicon-info-sign"></i>
                        <strong>Nota:</strong> Solo podrás ver las solicitudes asociadas con el correo electrónico proporcionado.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>