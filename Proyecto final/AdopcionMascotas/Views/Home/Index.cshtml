@model IEnumerable<AdopcionMascotas.Models.Mascota>

@{
    ViewBag.Title = "Portal de Adopción de Mascotas";
}

<!-- Hero Section -->
<div class="jumbotron text-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 60px 0;">
    <h1 class="display-3">
        <i class="glyphicon glyphicon-heart"></i>
        Adopta una Mascota
    </h1>
    <p class="lead">Encuentra a tu compañero perfecto. Dale una segunda oportunidad a un animal que necesita un hogar.</p>
    <p>
        <a class="btn btn-light btn-lg" href="@Url.Action("Index", "Mascotas")" role="button">
            <i class="glyphicon glyphicon-search"></i> Ver Mascotas Disponibles
        </a>
    </p>
</div>

<!-- Estadísticas -->
<div class="row text-center" style="margin-bottom: 40px;">
    <div class="col-md-6">
        <div class="well" style="background-color: #e3f2fd; border: 3px solid #2196f3; padding: 30px;">
            <h1 style="color: #1976d2; margin: 0; font-size: 72px;">@ViewBag.TotalMascotas</h1>
            <h4 style="margin-top: 15px;"><strong>Mascotas Disponibles</strong></h4>
            <p class="text-muted">Esperando un hogar lleno de amor</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="well" style="background-color: #e8f5e9; border: 3px solid #4caf50; padding: 30px;">
            <h1 style="color: #388e3c; margin: 0; font-size: 72px;">@ViewBag.TotalAdoptados</h1>
            <h4 style="margin-top: 15px;"><strong>Mascotas Adoptadas</strong></h4>
            <p class="text-muted">Finales felices logrados</p>
        </div>
    </div>
</div>

<!-- Mascotas Destacadas -->
<div class="row">
    <div class="col-md-12">
        <h2 class="text-center" style="margin-bottom: 30px;">
            <i class="glyphicon glyphicon-star"></i> Mascotas Destacadas
        </h2>
    </div>
</div>

<div class="row">
    @if (Model != null && Model.Any())
    {
        foreach (var mascota in Model)
        {
            <div class="col-md-4" style="margin-bottom: 30px;">
                <div class="panel panel-default" style="border-radius: 10px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                    <div class="panel-body" style="padding: 0;">
                        <img src="@mascota.FotoUrl" alt="@mascota.Nombre"
                             style="width: 100%; height: 250px; object-fit: cover;">
                        <div style="padding: 15px;">
                            <h4>
                                <strong>@mascota.Nombre</strong>
                                <span class="label label-info pull-right">@mascota.Especie</span>
                            </h4>
                            <p>
                                <i class="glyphicon glyphicon-tag"></i> <strong>Raza:</strong> @(mascota.Raza ?? "Mestizo")<br />
                                <i class="glyphicon glyphicon-time"></i> <strong>Edad:</strong> @(mascota.Edad ?? 0) años<br />
                                <i class="glyphicon glyphicon-resize-small"></i> <strong>Tamaño:</strong> @mascota.Tamanio
                            </p>
                            <p style="color: #666; min-height: 60px;">
                                @(mascota.Descripcion != null && mascota.Descripcion.Length > 100
                                    ? mascota.Descripcion.Substring(0, 100) + "..."
                                    : mascota.Descripcion)
                            </p>
                            <a href="@Url.Action("Details", "Mascotas", new { id = mascota.Id })"
                               class="btn btn-primary btn-block">
                                <i class="glyphicon glyphicon-info-sign"></i> Ver Detalles
                            </a>
                            @if (mascota.Estado == "Disponible")
                            {
                                <a href="@Url.Action("Solicitar", "Solicitudes", new { id = mascota.Id })"
                                   class="btn btn-success">
                                    <i class="glyphicon glyphicon-heart"></i> Adoptar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-md-12">
            <div class="alert alert-info text-center">
                <h4>No hay mascotas disponibles en este momento</h4>
            </div>
        </div>
    }
</div>

<!-- Botón para ver todas -->
<div class="row">
    <div class="col-md-12 text-center" style="margin-top: 20px;">
        <a href="@Url.Action("Index", "Mascotas")" class="btn btn-success btn-lg">
            <i class="glyphicon glyphicon-th-list"></i> Ver Todas las Mascotas
        </a>
    </div>
</div>

<!-- Sección de información -->
<div class="row" style="margin-top: 60px; margin-bottom: 40px;">
    <div class="col-md-4">
        <div class="text-center">
            <span class="glyphicon glyphicon-heart" style="font-size: 48px; color: #e91e63;"></span>
            <h3>Adopta con Amor</h3>
            <p>Cada mascota merece un hogar lleno de amor y cuidado. Encuentra tu compañero perfecto.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="text-center">
            <span class="glyphicon glyphicon-ok-circle" style="font-size: 48px; color: #4caf50;"></span>
            <h3>Proceso Seguro</h3>
            <p>Nuestro proceso de adopción garantiza el bienestar tanto de las mascotas como de los adoptantes.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="text-center">
            <span class="glyphicon glyphicon-user" style="font-size: 48px; color: #2196f3;"></span>
            <h3>Apoyo Continuo</h3>
            <p>Te acompañamos durante todo el proceso y después de la adopción.</p>
        </div>
    </div>
</div>