@model IEnumerable<AdopcionMascotas.Models.Solicitud>

@{
    ViewBag.Title = "Gestionar Solicitudes";
}

<div class="row">
    <div class="col-md-12">
        <h2>
            <i class="glyphicon glyphicon-envelope"></i> Gestionar Solicitudes de Adopción
        </h2>
        <hr />

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                <i class="glyphicon glyphicon-ok"></i> @TempData["Success"]
            </div>
        }

        <!-- Filtros -->
        <div class="well">
            <div class="row">
                <div class="col-md-3">
                    <a href="@Url.Action("Solicitudes", "Admin")"
                       class="btn btn-default btn-block @(string.IsNullOrEmpty(ViewBag.EstadoSeleccionado) ? "active" : "")">
                        Todas (@Model.Count())
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="@Url.Action("Solicitudes", "Admin", new { estado = "Pendiente" })"
                       class="btn btn-warning btn-block @(ViewBag.EstadoSeleccionado == "Pendiente" ? "active" : "")">
                        Pendientes (@ViewBag.TotalPendientes)
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="@Url.Action("Solicitudes", "Admin", new { estado = "Aprobada" })"
                       class="btn btn-success btn-block @(ViewBag.EstadoSeleccionado == "Aprobada" ? "active" : "")">
                        Aprobadas (@ViewBag.TotalAprobadas)
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="@Url.Action("Solicitudes", "Admin", new { estado = "Rechazada" })"
                       class="btn btn-danger btn-block @(ViewBag.EstadoSeleccionado == "Rechazada" ? "active" : "")">
                        Rechazadas (@ViewBag.TotalRechazadas)
                    </a>
                </div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr style="background-color: #f5f5f5;">
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Mascota</th>
                            <th>Solicitante</th>
                            <th>Contacto</th>
                            <th>Comentarios</th>
                            <th>Estado</th>
                            <th style="width: 200px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var solicitud in Model)
                        {
                            <tr>
                                <td><strong>#@solicitud.Id</strong></td>
                                <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy")<br /><small>@solicitud.FechaSolicitud.ToString("HH:mm")</small></td>
                                <td>
                                    <strong>@solicitud.Mascota.Nombre</strong><br />
                                    <small class="text-muted">@solicitud.Mascota.Especie - @solicitud.Mascota.Raza</small>
                                </td>
                                <td><strong>@solicitud.Usuario.NombreCompleto</strong></td>
                                <td>
                                    <i class="glyphicon glyphicon-envelope"></i> @solicitud.Usuario.Email<br />
                                    <i class="glyphicon glyphicon-phone"></i> @solicitud.Usuario.Telefono
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(solicitud.Comentarios))
                                    {
                                        if (solicitud.Comentarios.Length > 50)
                                        {
                                            <span title="@solicitud.Comentarios">@solicitud.Comentarios.Substring(0, 50)...</span>
                                        }
                                        else
                                        {
                                            @solicitud.Comentarios
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin comentarios</span>
                                    }
                                </td>
                                <td>
                                    @if (solicitud.Estado == "Pendiente")
                                    {
                                        <span class="label label-warning" style="font-size: 12px; padding: 5px 10px;">
                                            <i class="glyphicon glyphicon-time"></i> Pendiente
                                        </span>
                                    }
                                    else if (solicitud.Estado == "Aprobada")
                                    {
                                        <span class="label label-success" style="font-size: 12px; padding: 5px 10px;">
                                            <i class="glyphicon glyphicon-ok"></i> Aprobada
                                        </span>
                                        if (solicitud.FechaRespuesta.HasValue)
                                        {
                                            <br /><small>@solicitud.FechaRespuesta.Value.ToString("dd/MM/yyyy")</small>
                                        }
                                    }
                                    else if (solicitud.Estado == "Rechazada")
                                    {
                                        <span class="label label-danger" style="font-size: 12px; padding: 5px 10px;">
                                            <i class="glyphicon glyphicon-remove"></i> Rechazada
                                        </span>
                                        if (solicitud.FechaRespuesta.HasValue)
                                        {
                                            <br /><small>@solicitud.FechaRespuesta.Value.ToString("dd/MM/yyyy")</small>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (solicitud.Estado == "Pendiente")
                                    {
                                        <form action="@Url.Action("AprobarSolicitud", "Admin")" method="post" style="display:inline;"
                                              onsubmit="return confirm('¿Aprobar solicitud de @solicitud.Usuario.NombreCompleto para @solicitud.Mascota.Nombre?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@solicitud.Id" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="glyphicon glyphicon-ok"></i> Aprobar
                                            </button>
                                        </form>
                                        <br /><br />
                                        <button type="button" class="btn btn-danger btn-sm" onclick="mostrarRechazo(@solicitud.Id)">
                                            <i class="glyphicon glyphicon-remove"></i> Rechazar
                                        </button>
                                        <div id="rechazo@(solicitud.Id)" style="display:none; margin-top:10px;">
                                            <form action="@Url.Action("RechazarSolicitud", "Admin")" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@solicitud.Id" />
                                                <textarea name="motivoRechazo" class="form-control" rows="2" placeholder="Motivo del rechazo" required></textarea>
                                                <button type="submit" class="btn btn-danger btn-xs" style="margin-top:5px;">Confirmar Rechazo</button>
                                                <button type="button" class="btn btn-default btn-xs" style="margin-top:5px;" onclick="ocultarRechazo(@solicitud.Id)">Cancelar</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Ya procesada</span>
                                        if (solicitud.Estado == "Rechazada" && !string.IsNullOrEmpty(solicitud.MotivoRechazo))
                                        {
                                            <br /><br />
                                            <small><strong>Motivo:</strong><br />@solicitud.MotivoRechazo</small>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <h4>No hay solicitudes para mostrar</h4>
            </div>
        }

        <div class="text-center" style="margin-top: 30px;">
            <a href="@Url.Action("Index", "Admin")" class="btn btn-default">
                <i class="glyphicon glyphicon-arrow-left"></i> Volver al Panel
            </a>
        </div>
    </div>
</div>

<script>
    function mostrarRechazo(id) {
        document.getElementById('rechazo' + id).style.display = 'block';
    }
    function ocultarRechazo(id) {
        document.getElementById('rechazo' + id).style.display = 'none';
    }
</script>